<%= form_with(model: post, class: "space-y-6") do |form| %>
  <% if post.errors.any? %>
    <div class="bg-red-50 text-red-600 rounded-lg p-3 text-sm">
      <p class="font-medium"><%= pluralize(post.errors.count, "error") %> prohibited this post from being saved:</p>
      <ul class="list-disc ml-4 mt-1">
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "block text-sm font-medium text-black mb-2" %>
    <%= form.text_field :title, autofocus: post.new_record?, class: "bg-gray-50 border rounded-lg px-3 py-2 w-full focus:border-blue-600 focus:ring-2 focus:ring-blue-600/15 focus:outline-none transition-colors #{post.errors[:title].any? ? 'border-red-400' : 'border-gray-200'}" %>
    <% if post.errors[:title].any? %>
      <p class="text-red-600 text-sm mt-1"><%= post.errors[:title].first %></p>
    <% end %>
  </div>

  <div>
    <%= form.label :body, "Content", class: "block text-sm font-medium text-black mb-2" %>
    <div class="trix-wrapper">
      <%= form.rich_text_area :body, class: "w-full" %>
    </div>
    <% if post.errors[:body].any? %>
      <p class="text-red-600 text-sm mt-1"><%= post.errors[:body].first %></p>
    <% end %>
  </div>

  <div>
    <%= form.label :cover_image, "Cover Image", class: "block text-sm font-medium text-black mb-2" %>
    <%= form.file_field :cover_image, accept: "image/*",
        class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-medium file:bg-gray-100 file:text-black hover:file:bg-gray-200 transition-colors" %>
    <% if post.cover_image.attached? %>
      <p class="text-gray-500 text-xs mt-1">Image attached. Upload a new one to replace.</p>
    <% end %>
  </div>

  <div>
    <%= form.label :tag_ids, "Tags", class: "block text-sm font-medium text-black mb-2" %>
    <div class="flex flex-wrap gap-2">
      <%= form.collection_check_boxes :tag_ids, Tag.all, :id, :name do |b| %>
        <label class="inline-flex items-center gap-1 bg-gray-50 border border-gray-200 rounded-full px-3 py-1 text-sm cursor-pointer hover:bg-gray-100 transition-colors">
          <%= b.check_box(class: "mr-1") %>
          <%= b.label(class: "cursor-pointer") { b.text } %>
        </label>
      <% end %>
    </div>
  </div>

  <div class="flex flex-col sm:flex-row gap-3 pt-2">
    <%= form.submit (post.persisted? ? "Update" : "Publish"), class: "w-full sm:w-auto bg-black text-white rounded-full px-6 py-3 text-sm font-medium hover:bg-gray-800 transition-colors cursor-pointer" %>
    <% if post.persisted? %>
      <%= link_to "Cancel", post_path(post), class: "w-full sm:w-auto text-center border border-gray-200 rounded-full px-6 py-3 text-sm font-medium hover:bg-gray-50 transition-colors" %>
    <% end %>
  </div>
<% end %>
