<% content_for :title, "OddlyHonest" %>

<% if @posts.any? %>
  <div class="divide-y divide-gray-200">
    <% @posts.each_with_index do |post, index| %>
      <article class="<%= index > 0 ? 'py-8' : 'pb-8' %>">
        <%= link_to post_path(post), class: "group block" do %>
          <% if post.cover_image.attached? %>
            <div class="mb-4">
              <%= image_tag post.cover_image, class: "rounded-lg w-full max-h-48 object-cover" %>
            </div>
          <% end %>
          <h2 class="<%= index == 0 ? 'text-2xl' : 'text-xl' %> font-semibold text-black group-hover:text-blue-600 transition-colors duration-200">
            <%= post.title %>
          </h2>
        <% end %>
        <p class="text-gray-600 mt-2 leading-relaxed"><%= post.excerpt %></p>
        <div class="mt-3 flex flex-wrap items-center gap-2">
          <% if post.tags.any? %>
            <% post.tags.each do |tag| %>
              <span class="inline-block bg-blue-50 text-blue-700 text-xs px-2 py-0.5 rounded-full"><%= tag.name %></span>
            <% end %>
          <% end %>
          <span class="text-sm text-gray-500">
            <%= post.user&.email || "Anonymous" %> · <%= post.created_at.strftime("%b %-d, %Y") %> · <%= post.reading_time %> min read
            <% if post.published? %>
              · <span class="text-emerald-600">Published</span>
            <% end %>
          </span>
        </div>
      </article>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-16">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-gray-300 opacity-30 mb-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
    </svg>
    <h2 class="text-xl font-semibold text-black">OddlyHonest is ready</h2>
    <p class="text-gray-600 mt-2">Share your first truth</p>
    <% if user_signed_in? %>
      <%= link_to "Start writing", new_post_path, class: "mt-6 inline-block bg-black text-white rounded-full px-6 py-3 text-sm font-medium hover:bg-gray-800 transition-colors" %>
    <% else %>
      <%= link_to "Sign up to write", new_user_registration_path, class: "mt-6 inline-block bg-black text-white rounded-full px-6 py-3 text-sm font-medium hover:bg-gray-800 transition-colors" %>
    <% end %>
  </div>
<% end %>
