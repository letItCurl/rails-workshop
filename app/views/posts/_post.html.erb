<div id="<%= dom_id post %>" class="w-full sm:w-auto my-5 space-y-3">
  <% if post.cover_image.attached? %>
    <div class="mb-3">
      <%= image_tag post.cover_image, class: "rounded-md max-h-64 object-cover w-full" %>
    </div>
  <% end %>
  <div>
    <strong class="block font-medium mb-1">Title:</strong>
    <%= post.title %>
  </div>
  <div class="prose">
    <%= post.body %>
  </div>
  <% if post.tags.any? %>
    <div class="flex flex-wrap gap-1 mt-2">
      <% post.tags.each do |tag| %>
        <span class="inline-block bg-blue-100 text-blue-800 text-xs px-2 py-1 rounded-full"><%= tag.name %></span>
      <% end %>
    </div>
  <% end %>
  <div class="text-sm text-gray-500 mt-1">
    Posted by: <%= post.user&.email || "Anonymous" %>
  </div>
</div>
