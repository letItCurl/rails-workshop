<% content_for :title, @post.title %>

<%= link_to "← Back to posts", posts_path, class: "text-gray-600 hover:text-blue-600 text-sm mb-6 inline-block" %>

<article>
  <header class="mb-8">
    <% if @post.cover_image.attached? %>
      <div class="mb-6">
        <%= image_tag @post.cover_image, class: "rounded-lg w-full max-h-72 object-cover" %>
      </div>
    <% end %>

    <h1 class="text-3xl font-bold lg:text-4xl"><%= @post.title %></h1>

    <div class="mt-3 flex flex-wrap items-center gap-2">
      <% if @post.tags.any? %>
        <% @post.tags.each do |tag| %>
          <span class="inline-block bg-blue-50 text-blue-700 text-xs px-2 py-0.5 rounded-full"><%= tag.name %></span>
        <% end %>
      <% end %>
      <span class="text-sm text-gray-500">
        <%= @post.user&.email || "Anonymous" %> · <%= @post.created_at.strftime("%b %-d, %Y") %> · <%= @post.reading_time %> min read
      </span>
      <% if @post.published? %>
        <span class="inline-block bg-emerald-50 text-emerald-700 text-xs px-2 py-0.5 rounded-full">Published</span>
      <% end %>
    </div>
  </header>

  <%= turbo_frame_tag @post do %>
    <div class="prose prose-lg prose-gray font-serif">
      <%= @post.body %>
    </div>

    <% if user_signed_in? && current_user == @post.user %>
      <footer class="mt-12 pt-8 border-t border-gray-200 flex flex-col sm:flex-row gap-3">
        <% unless @post.published? %>
          <%= button_to "Publish", post_path(@post), method: :patch,
              params: { post: { published: true } },
              class: "w-full sm:w-auto text-center bg-emerald-600 text-white rounded-lg px-4 py-2 text-sm font-medium hover:bg-emerald-700 transition-colors cursor-pointer" %>
          <%= link_to "Edit inline", edit_post_path(@post),
              class: "w-full sm:w-auto text-center border border-gray-200 rounded-lg px-4 py-2 text-sm font-medium hover:bg-gray-50 transition-colors" %>
        <% end %>
        <%= button_to "Delete", @post, method: :delete, form_class: "w-full sm:w-auto", class: "w-full text-center text-red-600 border border-red-200 rounded-lg px-4 py-2 text-sm font-medium hover:bg-red-50 transition-colors cursor-pointer", data: { turbo_confirm: "Are you sure you want to delete this post?" } %>
      </footer>
    <% end %>
  <% end %>
</article>

<section class="mt-12 pt-8 border-t border-gray-200">
  <h2 class="text-xl font-semibold mb-6">Comments</h2>

  <%= turbo_stream_from @post %>

  <div id="comments" class="divide-y divide-gray-100">
    <% @post.comments.includes(:user).each do |comment| %>
      <%= render comment %>
    <% end %>
  </div>

  <% if user_signed_in? %>
    <div class="mt-8">
      <%= form_with(model: Comment.new, url: comments_path, class: "space-y-3") do |f| %>
        <%= f.hidden_field :post_id, value: @post.id %>
        <%= f.text_area :body, rows: 3, placeholder: "Share your truth...",
            class: "w-full bg-gray-50 border border-gray-200 rounded-lg px-3 py-2 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/15 focus:outline-none transition-colors" %>
        <%= f.submit "Comment", class: "bg-black text-white rounded-full px-5 py-2 text-sm font-medium hover:bg-gray-800 transition-colors cursor-pointer" %>
      <% end %>
    </div>
  <% end %>
</section>
