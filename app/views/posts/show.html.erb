<% content_for :title, "Showing post" %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="font-bold text-4xl">Showing post</h1>

  <%= render @post %>

  <% if @post.published? %>
    <span class="inline-block bg-green-100 text-green-800 text-sm px-3 py-1 rounded-full mb-4">Published</span>
  <% end %>

  <div class="flex flex-wrap gap-2 mt-4">
    <% unless @post.published? %>
      <%= button_to "Publish", post_path(@post), method: :patch,
          params: { post: { published: true } },
          class: "rounded-md px-3.5 py-2.5 bg-green-600 text-white hover:bg-green-700 font-medium cursor-pointer" %>
      <%= link_to "Edit this post", edit_post_path(@post), class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
    <% end %>
    <%= link_to "Back to posts", posts_path, class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
    <%= button_to "Destroy this post", @post, method: :delete, class: "rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
  </div>

  <h2 class="font-bold text-2xl mt-8 mb-4">Comments</h2>

  <% @post.comments.includes(:user).each do |comment| %>
    <div class="border-b border-gray-200 py-3">
      <p class="text-gray-800"><%= comment.body %></p>
      <p class="text-sm text-gray-500"><%= comment.user&.email || "Anonymous" %> — <%= time_ago_in_words(comment.created_at) %> ago</p>
    </div>
  <% end %>

  <% if user_signed_in? %>
    <h3 class="font-medium text-lg mt-6 mb-2">Add a comment</h3>
    <%= form_with(model: Comment.new, url: comments_path) do |f| %>
      <%= f.hidden_field :post_id, value: @post.id %>
      <div class="mb-3">
        <%= f.text_area :body, rows: 3, placeholder: "Share your truth...",
            class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>
      <%= f.submit "Comment", class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 cursor-pointer" %>
    <% end %>
  <% end %>
</div>
