<h1 class="text-3xl font-bold mb-8">Forgot your password?</h1>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-6" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div>
    <%= f.label :email, class: "block text-sm font-medium text-black mb-2" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email",
        class: "bg-gray-50 border border-gray-200 rounded-lg px-3 py-2 w-full focus:border-blue-600 focus:ring-2 focus:ring-blue-600/15 focus:outline-none transition-colors" %>
  </div>

  <div>
    <%= f.submit "Send reset instructions", class: "w-full bg-black text-white rounded-full px-6 py-3 text-sm font-medium hover:bg-gray-800 transition-colors cursor-pointer" %>
  </div>
<% end %>

<div class="mt-6 text-sm text-center">
  <%= render "devise/shared/links" %>
</div>
