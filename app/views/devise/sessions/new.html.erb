<h1 class="text-3xl font-bold mb-8">Log in</h1>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
  <div>
    <%= f.label :email, class: "block text-sm font-medium text-black mb-2" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email",
        class: "bg-gray-50 border border-gray-200 rounded-lg px-3 py-2 w-full focus:border-blue-600 focus:ring-2 focus:ring-blue-600/15 focus:outline-none transition-colors" %>
  </div>

  <div>
    <%= f.label :password, class: "block text-sm font-medium text-black mb-2" %>
    <%= f.password_field :password, autocomplete: "current-password",
        class: "bg-gray-50 border border-gray-200 rounded-lg px-3 py-2 w-full focus:border-blue-600 focus:ring-2 focus:ring-blue-600/15 focus:outline-none transition-colors" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="flex items-center gap-2">
      <%= f.check_box :remember_me %>
      <%= f.label :remember_me, class: "text-sm text-gray-600" %>
    </div>
  <% end %>

  <div>
    <%= f.submit "Log in", class: "w-full bg-black text-white rounded-full px-6 py-3 text-sm font-medium hover:bg-gray-800 transition-colors cursor-pointer" %>
  </div>
<% end %>

<div class="mt-6 text-sm text-center">
  <%= render "devise/shared/links" %>
</div>
