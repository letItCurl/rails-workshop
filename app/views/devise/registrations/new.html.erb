<h1 class="text-3xl font-bold mb-8">Sign up</h1>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-6" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div>
    <%= f.label :email, class: "block text-sm font-medium text-black mb-2" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email",
        class: "bg-gray-50 border border-gray-200 rounded-lg px-3 py-2 w-full focus:border-blue-600 focus:ring-2 focus:ring-blue-600/15 focus:outline-none transition-colors" %>
  </div>

  <div>
    <%= f.label :password, class: "block text-sm font-medium text-black mb-2" %>
    <% if @minimum_password_length %>
      <p class="text-xs text-gray-500 mb-1"><%= @minimum_password_length %> characters minimum</p>
    <% end %>
    <%= f.password_field :password, autocomplete: "new-password",
        class: "bg-gray-50 border border-gray-200 rounded-lg px-3 py-2 w-full focus:border-blue-600 focus:ring-2 focus:ring-blue-600/15 focus:outline-none transition-colors" %>
  </div>

  <div>
    <%= f.label :password_confirmation, class: "block text-sm font-medium text-black mb-2" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password",
        class: "bg-gray-50 border border-gray-200 rounded-lg px-3 py-2 w-full focus:border-blue-600 focus:ring-2 focus:ring-blue-600/15 focus:outline-none transition-colors" %>
  </div>

  <div>
    <%= f.submit "Sign up", class: "w-full bg-black text-white rounded-full px-6 py-3 text-sm font-medium hover:bg-gray-800 transition-colors cursor-pointer" %>
  </div>
<% end %>

<div class="mt-6 text-sm text-center">
  <%= render "devise/shared/links" %>
</div>
