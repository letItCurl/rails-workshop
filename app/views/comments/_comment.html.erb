<div id="<%= dom_id comment %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Body:</strong>
    <%= comment.body %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Post:</strong>
    <%= comment.post_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">User:</strong>
    <%= comment.user_id %>
  </div>
</div>
